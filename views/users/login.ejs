<% layout('layouts/boilerplate') %>

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow" style="max-width: 420px; width: 100%;">
        <img src="https://images3.alphacoders.com/151/thumb-1920-151005.jpg"
             alt="" class="card-img-top" />
        <div class="card-body">
            <h4 class="card-title mb-4 text-center fw-bold">Login</h4>

            <form action="/login" method="POST" class="validated-form" novalidate>
                
                <div class="mb-3">
                    <label class="form-label" for="username">Username</label>
                    <input class="form-control" 
                           type="text" 
                           id="username" 
                           name="username" 
                           autofocus 
                           required>
                    <div class="valid-feedback">Looks good!</div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <input class="form-control" 
                           type="password" 
                           id="password" 
                           name="password" 
                           required>
                    <div class="valid-feedback">Looks good!</div>
                </div>

                <button class="btn btn-success w-100">Login</button>
            </form>

        </div>
    </div>
</div>